# RMBench Environment Variables
# ==============================
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
#
# REQUIRED: GROQ_API_KEY
# OPTIONAL: everything else

# ------------------------------------------------------------------------------
# GROQ API (required)
# ------------------------------------------------------------------------------
# All LLM inference in RMBench is served via the Groq API.
# Get a free key at: https://console.groq.com → API Keys
# The key starts with "gsk_"
GROQ_API_KEY=gsk_your_key_here

# ------------------------------------------------------------------------------
# HUGGING FACE (optional — only needed for gated embedding models)
# ------------------------------------------------------------------------------
# The default embedding model (all-MiniLM-L6-v2) is public and needs no token.
# Set HF_TOKEN only if you switch to a gated model in the retrieval config.
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# SENTENCE TRANSFORMERS CACHE (optional)
# ------------------------------------------------------------------------------
# Where sentence-transformers downloads and caches embedding models.
# Defaults to ~/.cache/torch/sentence_transformers
# SENTENCE_TRANSFORMERS_HOME=/path/to/cache

# HuggingFace model cache (affects both transformers and sentence-transformers).
# HF_HOME=/path/to/cache

# ------------------------------------------------------------------------------
# LOGGING (optional)
# ------------------------------------------------------------------------------
# Override the log level at runtime without editing config YAML files.
# Choices: DEBUG, INFO, WARNING, ERROR
# RMBENCH_LOG_LEVEL=INFO

# Path to the log file (default: logs/rmbench.log).
# RMBENCH_LOG_FILE=logs/rmbench.log

# ------------------------------------------------------------------------------
# OUTPUT (optional)
# ------------------------------------------------------------------------------
# Override the results directory without editing YAML configs.
# RMBENCH_RESULTS_DIR=results
